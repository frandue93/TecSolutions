---
interface Tech {
    name: string;
    icon: string;
    color: string;
    description: string;
}

const technologies: Tech[] = [
    {
        name: "Astro",
        icon: "/images/astro.svg",
        color: "#BC52EE",
        description: "Framework web ultrarrápido para sitios de contenido y aplicaciones modernas"
    },
    {
        name: "PHP + Laravel",
        icon: "/images/laravel.svg",
        color: "#FF2D20",
        description: "Framework PHP robusto para aplicaciones web empresariales escalables"
    },
    {
        name: "Inteligencia Artificial",
        icon: "/images/IAIcon.png",
        color: "#00D9FF",
        description: "IA y Machine Learning para soluciones innovadoras"
    },
    {
        name: "Python",
        icon: "/images/python.svg",
        color: "#3776AB",
        description: "Lenguaje versátil para desarrollo backend, análisis de datos e IA"
    },
    {
        name: "WordPress",
        icon: "/images/wordpress.svg",
        color: "#21759B",
        description: "CMS líder mundial para sitios web corporativos y blogs profesionales"
    },
    {
        name: "Git",
        icon: "/images/git.svg",
        color: "#F05032",
        description: "Control de versiones distribuido para gestión eficiente de código"
    },
    {
        name: "Vue.js",
        icon: "/images/vuedotjs.svg",
        color: "#41B883",
        description: "Framework JavaScript progresivo para interfaces de usuario reactivas"
    },
    {
        name: "SEO",
        icon: "/images/location-dot-solid-full.svg",
        color: "#4285F4",
        description: "Optimización para motores de búsqueda y posicionamiento web"
    }
];
---

<section class="tech-section">
    <div class="tech-container">

        <div class="tech-grid">
            {technologies.map((tech) => (
                <div class="tech-item">
                    <div class="hex-outer">
                        <svg class="hex-svg" viewBox="-6 -6 112 128" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <polygon
                                points="50,0 100,28.87 100,86.60 50,115.47 0,86.60 0,28.87"
                                fill="white"
                                stroke="white"
                                stroke-width="12"
                                stroke-linejoin="round"
                            />
                        </svg>
                        <div class="hex-content">
                            {tech.icon.startsWith('/')
                                ? <img src={tech.icon} alt={tech.name} class="tech-icon" loading="lazy" />
                                : <span class="tech-emoji">{tech.icon}</span>
                            }
                        </div>
                    </div>
                    <span class="tech-name">{tech.name}</span>
                    <p class="tech-desc">{tech.description}</p>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .tech-section {

        width: 100%;
    }

    .tech-container {
        max-width: 960px;
        margin: 0 auto;
    }

    .tech-title {
        text-align: center;
        font-size: clamp(1.4rem, 3vw, 2rem);
        font-weight: 800;
        color: #1e3a5f;
        margin-bottom: 3rem;
        letter-spacing: -0.02em;
    }

    .tech-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 2.5rem 1.5rem;
        justify-items: center;
    }

    /* ── Hexágono ── */
    .tech-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.6rem;
        cursor: default;
    }

    .hex-outer {
        position: relative;
        width: 110px;
        height: 127px; /* ratio pointy-top: height = width × √3/... ≈ 1.1547 */
        filter: drop-shadow(0 6px 18px rgba(30, 58, 95, 0.18));
        transition: filter 0.3s ease, transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .tech-item:hover .hex-outer {
        filter: drop-shadow(0 10px 28px rgba(30, 58, 95, 0.28));
        transform: translateY(-6px) scale(1.06);
    }

    .hex-svg {
        width: 100%;
        height: 100%;
        display: block;
        transition: filter 0.3s ease;
    }

    .hex-svg polygon {
        transition: fill 0.3s ease, stroke 0.3s ease;
    }

    .tech-item:hover .hex-svg polygon {
        fill: #f0f7ff;
        stroke: #f0f7ff;
    }

    .hex-content {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .tech-icon {
        width: 52px;
        height: 52px;
        object-fit: contain;
        transition: transform 0.3s ease;
    }

    .tech-emoji {
        font-size: 2.6rem;
        line-height: 1;
        transition: transform 0.3s ease;
    }

    .tech-item:hover .tech-icon,
    .tech-item:hover .tech-emoji {
        transform: scale(1.12);
    }

    .tech-name {
        font-size: 0.88rem;
        font-weight: 700;
        color: #ffffff;
        text-align: center;
        line-height: 1.2;
        transition: color 0.3s ease;
    }

    .tech-item:hover .tech-name {
        color: #1d4ed8;
    }

    .tech-desc {
        font-size: 0.72rem;
        color: #ffffff;
        text-align: center;
        line-height: 1.4;
        max-width: 120px;
        display: none;
    }

    /* ── Responsive ── */
    @media (max-width: 767px) {
        .tech-section {
            padding: 3rem 1.25rem;
        }

        .tech-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 2.5rem 2rem;
            max-width: 380px;
            margin: 0 auto;
        }

        .hex-outer {
            width: 120px;
            height: 139px;
        }

        .tech-icon {
            width: 56px;
            height: 56px;
        }

        .tech-emoji {
            font-size: 2.8rem;
        }

        .tech-name {
            font-size: 0.9rem;
        }
    }

    @media (min-width: 768px) and (max-width: 1023px) {
        .tech-grid {
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem 1rem;
        }

        .hex-outer {
            width: 100px;
            height: 100px;
        }
    }
</style>
