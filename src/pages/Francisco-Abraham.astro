---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';

const profileSummary = `Soy un perfil técnico con base industrial, especializado en automatización de procesos y programación interna para empresas. Mi foco está en diseñar soluciones que conecten maquinaria, sistemas y bases de datos para transformar datos operativos en información útil para la toma de decisiones. Aplicada a la optimización de procesos, trazabilidad, control y mejora de productividad. Me desenvuelvo bien en entornos exigentes, coordinando con distintos departamentos y priorizando siempre resultados medibles. Busco un proyecto donde aportar valor desde el primer día, asumir responsabilidad y seguir evolucionando en automatización industrial y sistemas internos.`;

const candidateName = 'Francisco Abraham Dueñas Alfaro';
const candidateHeadline = 'Programador Informático y Electromecánico Industrial';
const candidatePhone = '652 531 981';
const candidateEmail = 'fran_due@hotmail.es';
const candidatePhoto = '/images/foto_perfil_ed.png';

const experience = [
    {
        period: '2024 - 2025',
        role: 'Programador',
        company: 'La Casa de las Carcasas',
        duration: '2 años',
        summary: 'Desarrollo y mantenimiento de soluciones web con foco en negocio, automatización y mejora continua.',
        details: [
            'Desarrollo con PHP, JavaScript, Laravel, HTML5, Bootstrap y Bases de datos.',
            'Apoyo en automatizaciones y desarrollo con Python.',
            'Trabajo colaborativo con GitHub y adaptación a necesidades de distintos equipos.',
            'Participación en proyectos de mejora de procesos, integración de sistemas y optimización de flujos de trabajo.',
            'Desarrollo de soluciones internas para automatización y control de procesos.',
            'Colaboración en la mejora del sistema de pick to light',
            'Desarrollo de soluciones para la gestión de incidencias y mantenimiento preventivo, integrando datos operativos para mejorar la eficiencia y trazabilidad de las intervenciones.',
        ]
    },
    {
        period: '2017 - 2020',
        role: 'Mecatrónico Industrial',
        company: 'Andine / Medifer',
        duration: '3 años',
        summary: 'Mantenimiento industrial y montaje eléctrico en entornos de exigencia técnica y ritmo alto.',
        details: [
            'Mantenimiento correctivo y preventivo de instalaciones industriales.',
            'Montaje eléctrico bajo presión, priorizando seguridad y continuidad operativa.',
            'Capacidad para diagnosticar incidencias y coordinar intervenciones con rapidez.'
        ]
    },
    {
        period: '2013 - 2016',
        role: 'Operario de Inyección de Plásticos',
        company: 'LAAC Tacones',
        duration: '3 años',
        summary: 'Experiencia en producción, coordinación y mejora de procesos dentro de un entorno industrial.',
        details: [
            'Coordinación con diferentes departamentos para mantener el ritmo de producción.',
            'Implementación de procesos orientados a eficiencia y estabilidad operativa.',
            'Trabajo en equipo y adaptación constante a objetivos de planta.'
        ]
    }
];

const education = [
    {
        period: '2021 - 2023',
        title: 'Desarrollo de Aplicaciones Web',
        school: 'I.E.S. Macià Abela - Crevillente'
    },
    {
        period: '2015 - 2017',
        title: 'Mecatrónica Industrial',
        school: 'I.E.S. Macià Abela - Crevillente'
    },
    {
        period: '2010 - 2012',
        title: 'Bachillerato',
        school: 'I.E.S. Macià Abela - Crevillente'
    }
];

const strengths = [
    'Perfil híbrido: experiencia industrial y desarrollo web orientado a negocio.',
    'Capacidad para coordinarme con equipos técnicos y no técnicos.',
    'Enfoque práctico en productividad, procesos y resolución de problemas.',
    'Aprendizaje rápido y adaptación a entornos con presión y cambio constante.'
];

const knowledge = [
    'HTML5 / CSS3',
    'JavaScript',
    'PHP',
    'Laravel',
    'Bootstrap',
    'Python',
    'IA aplicada',
    'Salesforce',
    'WordPress',
    'GitHub',
    'SQL'
];

const languages = [
    'Castellano: nativo',
    'Valenciano: nativo',
    'Inglés: alto'
];
---

<PortfolioLayout
    title="Francisco Abraham Dueñas Alfaro | Portfolio CV"
    description="Francisco Abraham Dueñas Alfaro. Programador informático y electromecánico industrial orientado a desarrollo web, automatización e integración de IA."
>
    <main class="mx-auto flex min-h-screen w-full max-w-7xl flex-col px-5 py-8 sm:px-8 lg:px-10">
        <section class="portfolio-fade-up relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/5 px-6 py-8 shadow-2xl shadow-slate-950/30 backdrop-blur sm:px-10 sm:py-10 lg:px-14 lg:py-14">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(20,184,166,0.12),_transparent_35%),radial-gradient(circle_at_80%_20%,_rgba(249,115,22,0.18),_transparent_28%)]"></div>
            <div class="relative grid gap-10 lg:grid-cols-[1.35fr_0.9fr] lg:items-end">
                <div class="space-y-6">
                    <div class="flex flex-wrap gap-3 text-sm text-slate-200/90">
                        <span class="portfolio-chip rounded-full px-4 py-2">Mecatrónica</span>
                        <span class="portfolio-chip rounded-full px-4 py-2">Programación</span>
                        <span class="portfolio-chip rounded-full px-4 py-2">Automatización e IA</span>
                    </div>

                    <div class="space-y-4">
                        <p class="text-sm uppercase tracking-[0.35em] text-teal-300/90">Perfil profesional</p>
                        <p class="text-lg font-medium tracking-[0.08em] text-slate-200 sm:text-xl">{candidateName}</p>
                        <h1 class="portfolio-display max-w-4xl text-5xl font-semibold leading-none text-white sm:text-6xl lg:text-7xl">
                            {candidateHeadline}
                        </h1>
                        <p class="max-w-3xl text-base leading-8 text-slate-300 sm:text-lg">
                            Profesional con experiencia en desarrollo, automatización y entornos industriales. Capaz de conectar tecnología, operaciones y necesidades de negocio para convertir problemas complejos en mejoras concretas.
                        </p>
                    </div>

                    <div class="flex flex-wrap gap-3 text-sm text-slate-100">
                        <a href={`tel:${candidatePhone.replace(/\s+/g, '')}`} class="portfolio-chip rounded-full px-4 py-2 transition hover:border-teal-300/50 hover:text-teal-200">Tel. {candidatePhone}</a>
                        <a href={`mailto:${candidateEmail}`} class="portfolio-chip rounded-full px-4 py-2 transition hover:border-orange-300/50 hover:text-orange-200">{candidateEmail}</a>
                    </div>

                    <div class="flex flex-wrap gap-4">
                        <a href="#experiencia" class="rounded-full bg-teal-400 px-6 py-3 font-medium text-slate-950 transition hover:bg-teal-300">Ver experiencia</a>
                        <a href="#sobre-mi" class="rounded-full border border-white/15 px-6 py-3 font-medium text-white transition hover:border-orange-300 hover:text-orange-200">Sobre mí</a>
                    </div>
                </div>

                <aside class="portfolio-panel portfolio-glow rounded-[1.75rem] p-6 sm:p-8">
                    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                        <div>
                            <p class="text-sm uppercase tracking-[0.3em] text-slate-400">Resumen</p>
                            <h2 class="mt-2 text-2xl font-semibold text-white">Disponible para nuevas oportunidades</h2>
                            <p class="mt-2 text-sm text-slate-300">{candidateName}</p>
                        </div>
                        <img
                            src={candidatePhoto}
                            alt={`Foto de perfil de ${candidateName}`}
                            class="h-56 w-full max-w-[14rem] self-center rounded-2xl object-contain object-center shadow-lg shadow-slate-950/40 sm:h-64 sm:w-64 sm:max-w-none sm:self-auto sm:object-cover"
                            loading="eager"
                        />
                    </div>

                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                            <p class="text-sm text-slate-400">Última etapa</p>
                            <p class="mt-2 text-lg font-semibold text-white">Programador</p>
                            <p class="text-sm text-slate-300">PHP, Laravel, JS, Python, IA</p>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                            <p class="text-sm text-slate-400">Certificación</p>
                            <p class="mt-2 text-lg font-semibold text-white">Salesforce Associate</p>
                            <p class="text-sm text-slate-300">ID 3861904 · Nov 2023</p>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                            <p class="text-sm text-slate-400">Idiomas</p>
                            <p class="mt-2 text-lg font-semibold text-white">ES / VAL / EN</p>
                            <p class="text-sm text-slate-300">Nativo + inglés alto</p>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                            <p class="text-sm text-slate-400">Movilidad</p>
                            <p class="mt-2 text-lg font-semibold text-white">Permiso B</p>
                            <p class="text-sm text-slate-300">Vehículo propio</p>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-white/5 p-4 sm:col-span-2">
                            <p class="text-sm text-slate-400">Contacto</p>
                            <p class="mt-2 text-lg font-semibold text-white">{candidatePhone}</p>
                            <p class="text-sm text-slate-300">{candidateEmail}</p>
                        </div>
                    </div>
                </aside>
            </div>
        </section>

        <section class="grid gap-6 py-8 lg:grid-cols-[1.1fr_0.9fr] lg:py-10">
            <article id="sobre-mi" class="portfolio-panel portfolio-fade-up rounded-[1.75rem] p-7 sm:p-9">
                <p class="text-sm uppercase tracking-[0.3em] text-teal-300">Sobre mí</p>
                <h2 class="portfolio-display mt-3 text-4xl font-semibold text-white sm:text-5xl">Un perfil que entiende la técnica, el ritmo de trabajo y el impacto en el negocio.</h2>
                <div class="portfolio-divider mt-6 h-px w-full"></div>
                <p class="mt-6 text-base leading-8 text-slate-300 sm:text-lg">{profileSummary}</p>
            </article>

            <aside class="portfolio-panel portfolio-fade-up rounded-[1.75rem] p-7 sm:p-9">
                <p class="text-sm uppercase tracking-[0.3em] text-orange-300">Aporto valor en</p>
                <div class="mt-6 space-y-4">
                    {strengths.map((strength) => (
                        <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-4 text-slate-200">
                            {strength}
                        </div>
                    ))}
                </div>
            </aside>
        </section>

        <section id="experiencia" class="portfolio-fade-up py-4">
            <div class="mb-6 flex items-end justify-between gap-4">
                <div>
                    <p class="text-sm uppercase tracking-[0.3em] text-teal-300">Experiencia laboral</p>
                    <h2 class="portfolio-display mt-2 text-4xl font-semibold text-white sm:text-5xl">Trayectoria construida entre tecnología, industria y mejora continua.</h2>
                </div>
            </div>

            <div class="grid gap-5">
                {experience.map((item) => (
                    <article class="portfolio-panel rounded-[1.75rem] p-6 sm:p-8">
                        <div class="grid gap-6 lg:grid-cols-[220px_1fr] lg:gap-8">
                            <div>
                                <p class="text-sm uppercase tracking-[0.25em] text-slate-400">{item.period}</p>
                                <p class="mt-3 inline-flex rounded-full bg-orange-400/15 px-4 py-2 text-sm font-medium text-orange-200">{item.duration}</p>
                            </div>

                            <div>
                                <div class="flex flex-wrap items-start justify-between gap-4">
                                    <div>
                                        <h3 class="text-2xl font-semibold text-white">{item.role}</h3>
                                        <p class="mt-1 text-lg text-slate-300">{item.company}</p>
                                    </div>
                                    <span class="rounded-full border border-teal-400/30 bg-teal-400/10 px-4 py-2 text-sm text-teal-200">Experiencia destacada</span>
                                </div>

                                <p class="mt-5 text-base leading-7 text-slate-300">{item.summary}</p>

                                <div class="mt-6 grid gap-3 sm:grid-cols-3">
                                    {item.details.map((detail) => (
                                        <div class="rounded-2xl border border-white/10 bg-slate-900/60 p-4 text-sm leading-6 text-slate-200">
                                            {detail}
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    </article>
                ))}
            </div>
        </section>

        <section class="grid gap-6 py-8 lg:grid-cols-[0.95fr_1.05fr]">
            <article class="portfolio-panel portfolio-fade-up rounded-[1.75rem] p-7 sm:p-9">
                <p class="text-sm uppercase tracking-[0.3em] text-orange-300">Educación</p>
                <h2 class="portfolio-display mt-3 text-4xl font-semibold text-white">Base técnica con evolución clara hacia desarrollo.</h2>
                <div class="mt-8 space-y-4">
                    {education.map((item) => (
                        <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                            <p class="text-sm uppercase tracking-[0.24em] text-slate-400">{item.period}</p>
                            <h3 class="mt-2 text-xl font-semibold text-white">{item.title}</h3>
                            <p class="mt-1 text-slate-300">{item.school}</p>
                        </div>
                    ))}
                </div>
            </article>

            <article class="portfolio-panel portfolio-fade-up rounded-[1.75rem] p-7 sm:p-9">
                <div class="grid gap-8 lg:grid-cols-[1fr_0.9fr]">
                    <div>
                        <p class="text-sm uppercase tracking-[0.3em] text-teal-300">Conocimientos</p>
                        <h2 class="portfolio-display mt-3 text-4xl font-semibold text-white">Stack técnico y herramientas.</h2>
                        <div class="mt-7 flex flex-wrap gap-3">
                            {knowledge.map((item) => (
                                <span class="portfolio-chip rounded-full px-4 py-2 text-sm text-slate-100">{item}</span>
                            ))}
                        </div>
                    </div>

                    <div class="space-y-6">
                        <div class="rounded-[1.5rem] border border-white/10 bg-white/5 p-5">
                            <p class="text-sm uppercase tracking-[0.24em] text-slate-400">Idiomas</p>
                            <div class="mt-4 space-y-3">
                                {languages.map((item) => (
                                    <p class="text-base text-slate-200">{item}</p>
                                ))}
                            </div>
                        </div>

                        <div class="rounded-[1.5rem] border border-white/10 bg-gradient-to-br from-orange-400/15 to-teal-400/15 p-5">
                            <p class="text-sm uppercase tracking-[0.24em] text-slate-300">Certificado</p>
                            <h3 class="mt-3 text-2xl font-semibold text-white">Salesforce Associate</h3>
                            <p class="mt-2 text-slate-200">Nov 2023 · ID: 3861904</p>
                        </div>
                    </div>
                </div>
            </article>
        </section>

        <section class="portfolio-fade-up py-4">
            <div class="overflow-hidden rounded-[2rem] border border-white/10 bg-[linear-gradient(135deg,rgba(20,184,166,0.18),rgba(15,23,42,0.86),rgba(249,115,22,0.16))] px-7 py-8 shadow-2xl shadow-slate-950/30 sm:px-10 sm:py-10">
                <div class="grid gap-6 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
                    <div>
                        <p class="text-sm uppercase tracking-[0.3em] text-slate-300">Objetivo profesional</p>
                        <h2 class="portfolio-display mt-3 text-4xl font-semibold text-white sm:text-5xl">Aportar experiencia, criterio técnico y capacidad de ejecución en un equipo con ambición.</h2>
                    </div>
                    <div class="rounded-[1.5rem] border border-white/10 bg-slate-950/40 p-6">
                        <p class="text-base leading-8 text-slate-200">
                            Interesado en posiciones donde pueda participar en consultoría, automatización, mejora de procesos o proyectos con IA aplicada, aportando una visión práctica y orientada a resultados, así como al mantenimiento electromecánico.                        </p>
                    </div>
                </div>
            </div>
        </section>
    </main>
</PortfolioLayout>